{
  "name": "betterbuct-mobile",
  "version": "0.2.26",
  "private": true,
  "description": "BetterBUCT Android — Capacitor 原生壳 + 北化校园工作台",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:open:android": "cap open android",
    "android:build": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "android:release": "npm run build && cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.1.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "buffer": "^6.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iconv-lite": "^0.7.3",
    "jsrsasign": "^11.1.5",
    "lucide-react": "^0.536.0",
    "marked": "^18.0.9",
    "node-forge": "^1.4.0",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
