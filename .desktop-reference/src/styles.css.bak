@font-face { font-family: 'Cinzel'; src: url('./assets/fonts/Cinzel-500.ttf') format('truetype'); font-style: normal; font-weight: 500; font-display: swap; }
@font-face { font-family: 'Cinzel'; src: url('./assets/fonts/Cinzel-600.ttf') format('truetype'); font-style: normal; font-weight: 600; font-display: swap; }
@font-face { font-family: 'Cinzel'; src: url('./assets/fonts/Cinzel-700.ttf') format('truetype'); font-style: normal; font-weight: 700; font-display: swap; }
@font-face { font-family: 'Noto Serif SC'; src: url('./assets/fonts/NotoSerifSC-500.ttf') format('truetype'); font-style: normal; font-weight: 500; font-display: swap; }
@font-face { font-family: 'Noto Serif SC'; src: url('./assets/fonts/NotoSerifSC-600.ttf') format('truetype'); font-style: normal; font-weight: 600; font-display: swap; }

:root {
  font-family: "Segoe UI", "Microsoft YaHei", system-ui, sans-serif;
  color: #1d2927;
  background: #f4f7f6;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --ink: #1d2927;
  --muted: #6c7a76;
  --line: #dce6e2;
  --paper: #ffffff;
  --panel: #f8fbfa;
  --red: #ba424b;
  --red-dark: #8f2f38;
  --teal: #227d72;
  --teal-soft: #e1f0ed;
  --blue: #39668e;
  --amber: #bf782e;
  --shadow: 0 12px 30px rgba(31, 49, 45, .06);
}

/* THEIA 0.4 visual system: quiet workspace chrome, deliberate hierarchy. */
:root {
  color-scheme: light;
  --ink: #1d232b;
  --muted: #727982;
  --subtle: #a6adb5;
  --line: #e5e8ec;
  --line-strong: #d8dde3;
  --paper: #ffffff;
  --panel: #f8f9fa;
  --canvas: #f4f5f7;
  --red: #bb4650;
  --red-dark: #9d313d;
  --teal: #176c64;
  --teal-soft: #e7f4f1;
  --blue: #35658f;
  --amber: #9b6922;
  --shadow: 0 1px 2px rgba(24, 32, 41, .025), 0 16px 36px -28px rgba(24, 32, 41, .22);
  --shadow-float: 0 18px 50px -26px rgba(20, 31, 41, .34), 0 1px 2px rgba(20, 31, 41, .05);
  --radius: 10px;
  --ease-out: cubic-bezier(.2, .8, .2, 1);
}

html { background: var(--canvas); }
html, body, #root { width: 100%; height: 100%; overflow: hidden; }
body { min-height: 100%; background: var(--canvas); color: var(--ink); }
button, input, select { font-family: inherit; }
button { transition: color .14s var(--ease-out), background .14s var(--ease-out), border-color .14s var(--ease-out), box-shadow .14s var(--ease-out), transform .14s var(--ease-out); }
button:active:not(:disabled) { transform: scale(.98); }
button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid rgba(53, 101, 143, .52); outline-offset: 2px; }

@keyframes theia-rise-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@keyframes theia-soft-in { from { opacity: 0; transform: scale(.985); } to { opacity: 1; transform: scale(1); } }
@keyframes theia-message-in { from { opacity: 0; transform: translateY(-7px); } to { opacity: 1; transform: translateY(0); } }
@keyframes theia-sheen { 0%, 100% { opacity: .45; } 50% { opacity: .85; } }

.loading-screen { min-height: 100svh; gap: 12px; background: var(--canvas); }
.loading-screen strong { font-family: 'Cinzel', 'Noto Serif SC', Georgia, serif; color: var(--ink); font-size: 24px; font-weight: 600; letter-spacing: .12em; }
.loading-screen span { font-size: 12px; }
.brand-mark { width: 38px; height: 38px; border: 1px solid #dcc6b5; border-radius: 9px; box-shadow: 0 8px 22px -13px rgba(85, 43, 19, .6); }

.app-shell { width: 100%; height: 100%; min-height: 0; overflow: hidden; background: var(--canvas); }
.sidebar { width: 232px; height: 100%; flex-basis: 232px; min-height: 0; overflow-y: auto; scrollbar-width: none; padding: 22px 12px 15px; background: rgba(255, 255, 255, .86); border-right: 1px solid var(--line); box-shadow: none; }
.sidebar::-webkit-scrollbar, .workspace::-webkit-scrollbar { width: 0; height: 0; }
.brand { gap: 10px; padding: 0 10px 27px; }
.brand > div:last-of-type { gap: 0; }
.brand-wordmark strong { font-family: 'Cinzel', 'Noto Serif SC', Georgia, serif; color: var(--ink); font-size: 17px; font-weight: 600; letter-spacing: .1em; }
.brand-wordmark span { color: #96704d; font-family: 'Noto Serif SC', Georgia, serif; font-size: 12px; letter-spacing: .06em; }
.sidebar nav { gap: 2px; }
.sidebar nav button { position: relative; min-height: 40px; gap: 11px; padding: 0 11px; color: #65707a; border-radius: 7px; font-size: 12px; font-weight: 560; }
.sidebar nav button svg { width: 17px; height: 17px; stroke-width: 1.8; }
.sidebar nav button:hover { color: var(--ink); background: #f4f6f7; }
.sidebar nav button { isolation: isolate; }
.sidebar nav button::after { position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: #edf2f5; opacity: 0; transform: scale(.96); transition: opacity .16s var(--ease-out), transform .16s var(--ease-out); content: ''; }
.sidebar nav button:hover::after { opacity: 1; transform: scale(1); }
.sidebar nav button.active { color: #243747; background: #eaf0f4; font-weight: 700; }
.sidebar nav button.active::before { position: absolute; left: 0; width: 3px; height: 17px; border-radius: 0 3px 3px 0; background: var(--blue); content: ''; }
.sidebar nav button em { min-width: 18px; height: 18px; margin-left: auto; background: var(--red); border-radius: 9px; box-shadow: none; font-size: 10px; }
.legacy-nav { display: none !important; }
.grouped-nav { gap: 14px !important; }
.nav-group { display: grid; gap: 2px; }
.nav-group-label { padding: 0 11px 5px; color: #a1a9b1; font-size: 9px; font-weight: 750; letter-spacing: .14em; }
.nav-group + .nav-group { padding-top: 2px; border-top: 1px solid rgba(229, 232, 236, .72); }
.sync-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 26px; padding: 0 8px; color: #6d7780; background: rgba(255, 255, 255, .6); border: 1px solid var(--line); border-radius: 999px; font-size: 10px; white-space: nowrap; }
.sync-chip-dot { width: 6px; height: 6px; border-radius: 50%; background: #3a8d73; box-shadow: 0 0 0 3px rgba(58, 141, 115, .1); }
.sync-chip.syncing { color: #35658f; background: #edf4f9; border-color: #d7e5ef; }
.sync-chip.syncing .sync-chip-dot { background: #35658f; animation: theia-sheen 1s ease-in-out infinite; }
.sync-chip.failed { color: #9b6922; background: #fff8ea; border-color: #eee1bd; }
.sync-chip.failed .sync-chip-dot { background: #c58d30; }
.sidebar-status-dock { display: grid; gap: 7px; margin: -8px 10px 17px; padding: 9px 10px; background: rgba(246, 248, 249, .72); border: 1px solid var(--line); border-radius: 8px; }
.sidebar-status-dock > span:last-child { color: var(--muted); font-size: 10px; }
.sidebar > .brand { order: 0; }
.sidebar > .sidebar-status-dock { order: 1; }
.sidebar > .sidebar-nav, .sidebar > .legacy-nav { order: 2; }
.sidebar > .sidebar-bottom { order: 3; }
.sidebar-bottom { gap: 9px; }
.sync-summary { gap: 7px; padding: 11px 10px; background: transparent; border: 1px solid var(--line); border-radius: 8px; box-shadow: none; }
.sync-summary > div { gap: 7px; font-size: 11px; }
.sync-summary > span { color: var(--muted); font-size: 10px; }
.sync-light { width: 6px; height: 6px; background: #3a8d73; }
.sidebar-bottom > button { min-height: 32px; padding: 0 10px; color: var(--muted); font-size: 11px; }
.sidebar-bottom > button:hover { color: var(--ink); }

.workspace { min-height: 0; height: 100%; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; background: var(--canvas); }
.sync-progress-overlay { position: fixed; top: 0; right: 0; left: 0; z-index: 80; height: 2px; overflow: hidden; background: rgba(53, 101, 143, .12); pointer-events: none; }
.sync-progress-overlay i { display: block; height: 100%; background: linear-gradient(90deg, #35658f, #176c64); transition: width .35s var(--ease-out); }
.content-area > * { animation: theia-rise-in .34s var(--ease-out) both; }
.content-area > *:nth-child(2) { animation-delay: .035s; }
.content-area > *:nth-child(3) { animation-delay: .07s; }
.content-area > *:nth-child(4) { animation-delay: .105s; }
.content-area > *:nth-child(5) { animation-delay: .14s; }
.topbar { position: sticky; top: 0; z-index: 10; min-height: 76px; padding: 15px 38px; background: rgba(244, 245, 247, .88); border: 0; backdrop-filter: blur(18px); }
.topbar::after { position: absolute; right: 38px; bottom: 0; left: 38px; height: 1px; background: var(--line); content: ''; }
.page-title::before { width: 5px; height: 24px; flex: 0 0 5px; border-radius: 4px; background: #3c6f91; box-shadow: 0 0 0 4px rgba(60, 111, 145, .1); content: ''; }
.page-title { gap: 12px; }
.page-title h1 { color: var(--ink); font-family: 'Noto Serif SC', 'Segoe UI', sans-serif; font-size: 22px; font-weight: 600; letter-spacing: 0; }
.page-title p { margin-top: 3px; color: var(--muted); font-size: 11px; }
.top-actions { gap: 10px; }
.source-group { gap: 8px; padding-right: 2px; }
.source-status { gap: 5px; color: var(--muted); font-size: 10px; }
.source-status.connected { color: #337166; }
.icon-button { width: 34px; height: 34px; color: #63717d; border-radius: 7px; }
.icon-button:hover { color: var(--ink); background: #e9edef; border-color: transparent; }
.sync-button { color: #2b5a80; background: #e9f0f5; border: 1px solid transparent; }
.sync-button:hover { color: #244d6e; background: #dde9f1; }
.profile-chip { gap: 7px; color: #45505a; font-size: 12px; }
.profile-chip > div { width: 30px; height: 30px; background: #244258; font-size: 12px; }
.profile-chip > div { box-shadow: 0 0 0 4px rgba(36, 66, 88, .08); }
.search-box { width: 216px; height: 34px; gap: 7px; padding: 0 9px; color: #7f8993; background: transparent; border: 0; border-bottom: 1px solid var(--line-strong); border-radius: 0; }
.search-box:focus-within { border-color: #6688a5; }
.search-box input { font-size: 12px; }

.login-banner, .preview-banner, .message-bar, .sync-live-banner { margin: 0 38px; border-radius: 0 0 9px 9px; }
.sync-live-banner { padding: 11px 13px; color: #365e66; background: #eaf4f4; border: 1px solid #d5e9e6; border-top: 0; box-shadow: var(--shadow); }
.sync-live-banner strong { color: #24585b; font-size: 12px; }
.sync-live-banner span { color: #567b7e; font-size: 11px; }
.sync-live-banner small { color: #789092; font-size: 10px; }
.login-banner { padding: 11px 13px; color: #765440; background: #fbf5ef; border: 1px solid #eddfd2; border-top: 0; box-shadow: var(--shadow); }
.login-banner strong { color: #654334; font-size: 12px; }
.login-banner span { color: #866b5d; font-size: 11px; }
.login-banner button, .primary-button { min-height: 32px; padding: 0 12px; background: #244b69; border-radius: 6px; box-shadow: 0 6px 13px -9px rgba(25, 66, 97, .8); font-size: 11px; }
.login-banner button:hover, .primary-button:hover { background: #193d59; }
.message-bar { position: relative; overflow: hidden; padding: 10px 13px; background: #fff8e9; border: 1px solid #eee1b8; border-top: 0; box-shadow: var(--shadow); font-size: 11px; animation: theia-message-in .24s var(--ease-out) both; }
.message-bar::after { position: absolute; right: 0; bottom: 0; left: 0; height: 2px; background: #d6a93f; transform-origin: left; animation: message-timeout 6s linear both; content: ''; }
@keyframes message-timeout { from { transform: scaleX(1); } to { transform: scaleX(0); } }

.content-area { max-width: 1480px; padding: 30px 38px 56px; }
.dashboard-grid { grid-template-columns: minmax(0, 1.35fr) minmax(330px, .78fr); gap: 26px 30px; }
.quick-actions { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.quick-actions button { display: flex; align-items: center; gap: 9px; min-width: 0; min-height: 56px; padding: 8px 10px; color: var(--muted); background: rgba(255, 255, 255, .48); border: 1px solid transparent; border-radius: 8px; text-align: left; }
.quick-actions button:hover { color: var(--ink); background: rgba(255, 255, 255, .88); border-color: var(--line); box-shadow: var(--shadow); transform: translateY(-1px); }
.quick-actions button > span:nth-child(2) { min-width: 0; display: grid; gap: 2px; }
.quick-actions button > svg { margin-left: auto; color: #a3adb5; }
.quick-actions strong { overflow: hidden; color: inherit; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
.quick-actions small { overflow: hidden; color: #969fa7; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
.quick-action-icon { width: 30px; height: 30px; display: grid; place-items: center; flex: 0 0 30px; color: #39668e; background: #edf3f7; border-radius: 7px; }
.quick-actions button:nth-child(2) .quick-action-icon { color: #9d5e3a; background: #fbf1ed; }
.quick-actions button:nth-child(3) .quick-action-icon { color: #267267; background: #e8f5f0; }
.quick-actions button:nth-child(4) .quick-action-icon { color: #8b6a2c; background: #fbf5e5; }
.metric-strip, .grade-summary { gap: 0; overflow: visible; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.metric-strip button { position: relative; min-height: 94px; padding: 13px 18px; background: transparent; border-right: 1px solid var(--line); }
.metric-strip button:last-child { border-right: 0; }
.metric-strip button:hover { background: rgba(255, 255, 255, .45); }
.metric-strip button { animation: theia-soft-in .3s var(--ease-out) both; }
.metric-strip button:nth-child(2) { animation-delay: .04s; }
.metric-strip button:nth-child(3) { animation-delay: .08s; }
.metric-strip button:nth-child(4) { animation-delay: .12s; }
.metric-strip button svg { color: #426f91; }
.metric-strip span, .grade-summary span { color: var(--muted); font-size: 10px; }
.metric-strip strong, .grade-summary strong { color: var(--ink); font-size: 24px; font-weight: 650; }
.panel { padding: 0; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.panel-large { min-height: 0; }
.panel-heading { align-items: center; margin-bottom: 13px; padding-bottom: 11px; border-bottom: 1px solid var(--line); }
.panel-heading h2, .section-heading h2 { font-family: 'Noto Serif SC', 'Segoe UI', sans-serif; color: var(--ink); font-size: 17px; font-weight: 600; letter-spacing: 0; }
.eyebrow { color: #496f8e; font-size: 10px; font-weight: 700; letter-spacing: .12em; }
.text-command, .link-button { color: #396589; font-size: 11px; font-weight: 650; }
.text-command:hover, .link-button:hover { color: #244b69; }
.timeline-list, .task-list { gap: 0; }
.timeline-row, .task-row { min-height: 68px; padding: 10px 0; border-bottom: 1px solid var(--line); }
.timeline-row:last-child, .task-row:last-child { border-bottom: 0; }
.timeline-row, .task-row, .exam-row, .notice-list article { transition: background .16s var(--ease-out), padding-left .16s var(--ease-out), padding-right .16s var(--ease-out); }
.timeline-row:hover, .task-row:hover, .exam-row:hover, .notice-list article:hover { background: rgba(255,255,255,.46); }
.timeline-row:hover, .task-row:hover { padding-left: 7px; padding-right: 7px; }
.timeline-row strong, .task-row strong { font-size: 12px; }
.timeline-row span, .task-row span { font-size: 10px; }
.period-pill { min-height: 27px; color: #355d80; background: #eaf1f6; border-radius: 5px; font-size: 10px; }
.task-state { width: 26px; height: 26px; color: #287264; background: #e6f4f0; }
.task-state.urgent { color: #a54249; background: #faebeb; }
.task-actions { gap: 5px; }
.task-command { min-height: 27px; padding: 0 8px; color: #4e5f69; background: transparent; border: 1px solid var(--line-strong); border-radius: 5px; font-size: 10px; }
.task-command:hover:not(:disabled) { color: #285d68; background: #eef5f3; border-color: #bfdbd4; }
.task-command.emphasis { background: #267267; border-color: #267267; }
.exam-focus { min-height: 156px; gap: 16px; }
.date-block { width: 64px; height: 72px; color: #9b4148; background: #fbefed; border: 1px solid #f0d9d6; border-radius: 8px; }
.date-block strong { font-size: 23px; }
.exam-focus h3 { font-size: 16px; }
.exam-focus p { font-size: 11px; }
.seat-badge, .score-badge { color: #9a4149; background: #fbefed; border-radius: 4px; }
.notice-compact { gap: 0; }
.notice-compact button { padding: 11px 0; border-color: var(--line); }
.notice-compact strong { font-size: 11px; }

.schedule-toolbar { margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
.term-selector-group select, .selection-controls select, .selection-form input, .credential-form input, .model-service-form select, .numeric-setting input { min-height: 34px; color: var(--ink); background: #fff; border-color: var(--line-strong); border-radius: 6px; font-size: 11px; }
.segmented { padding: 2px; background: #e8ecef; border-radius: 7px; }
.segmented button { min-height: 28px; padding: 0 11px; border-radius: 5px; font-size: 10px; }
.segmented button.active { background: #fff; box-shadow: 0 1px 3px rgba(21, 35, 47, .1); }
.schedule-pdf-button { border-color: transparent; background: #e8f0f5; color: #315c7f; }
.schedule-board { gap: 8px; }
.day-column { min-height: 510px; background: rgba(255,255,255,.72); border: 1px solid var(--line); border-radius: 8px; box-shadow: none; }
.day-column > header { min-height: 57px; padding: 0 12px; }
.day-column > header strong { font-size: 12px; }
.day-courses { gap: 7px; padding: 8px; }
.course-slot { min-height: 122px; padding: 10px; background: #f5f8fa; border-left-width: 2px; border-radius: 5px; }
.course-slot h3 { margin: 6px 0 8px; font-size: 12px; }
.course-slot p, .course-slot small { font-size: 10px; }

.campus-map-panel { background: #e6eeec; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: none; }
.map-stage { background: #e6eeec; overscroll-behavior: none; }
.map-stage { touch-action: none; }
.map-stage:active { cursor: grabbing; }
.map-sheet { transition: transform .18s var(--ease-out); }
.map-stage.is-dragging .map-sheet { transition: none; }
.map-layer-controls, .map-zoom-controls { padding: 4px; background: rgba(255,255,255,.94); border-color: #dce3e1; border-radius: 8px; box-shadow: var(--shadow-float); }
.map-control-stack { gap: 8px; }
.map-zoom-hud { display: grid; gap: 2px; min-width: 128px; padding: 8px 10px; color: #5d6872; background: rgba(255,255,255,.92); border: 1px solid #dce3e1; border-radius: 8px; box-shadow: var(--shadow-float); backdrop-filter: blur(8px); }
.map-zoom-hud strong { color: #263d4e; font-size: 14px; font-variant-numeric: tabular-nums; }
.map-zoom-hud span { color: #89939b; font-size: 9px; }
.map-tool-button { border-radius: 5px; }
.map-control-stack { animation: theia-soft-in .3s var(--ease-out) both; }

.data-page { gap: 28px; }
.list-stack { gap: 0; border-top: 1px solid var(--line); }
.exam-row { min-height: 84px; padding: 16px 4px; background: transparent; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; box-shadow: none; }
.exam-date strong { font-size: 12px; }
.exam-main h3 { font-size: 14px; }
.grade-summary > div { padding: 14px 18px; background: transparent; border-right: 1px solid var(--line); }
.grade-summary > div:last-child { border-right: 0; }
.gpa-trend { padding: 0; background: transparent; border: 0; box-shadow: none; }
.gpa-chart-controls { gap: 5px; }
.gpa-chart-wrap { padding: 10px 0 0; }
.gpa-line { stroke: #326c76; }
.gpa-line { stroke-dasharray: 1200; stroke-dashoffset: 1200; animation: gpa-draw .8s .12s var(--ease-out) forwards; }
@keyframes gpa-draw { to { stroke-dashoffset: 0; } }
.gpa-point { stroke: #326c76; }
.gpa-point { animation: theia-soft-in .24s var(--ease-out) both; }
.data-table-wrap { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); border-radius: 0; }
.data-table { font-size: 11px; }
.data-table th { color: var(--muted); background: transparent; font-size: 10px; font-weight: 650; }
.data-table td { border-color: var(--line); }
.data-table tbody tr:hover { background: rgba(255,255,255,.72); }
.data-table tbody tr { animation: theia-rise-in .3s var(--ease-out) both; }
.data-table tbody tr:nth-child(2) { animation-delay: .03s; }
.data-table tbody tr:nth-child(3) { animation-delay: .06s; }
.data-table tbody tr:nth-child(4) { animation-delay: .09s; }

.progress-summary { gap: 0; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.progress-summary > div { padding: 14px 18px; background: transparent; border-right: 1px solid var(--line); }
.progress-summary > div:last-child { border-right: 0; }
.progress-summary strong { font-size: 23px; }
.section-heading { padding-bottom: 12px; border-bottom: 1px solid var(--line); }
.section-heading > span { font-size: 11px; }
.requirement-map { gap: 0; border-top: 1px solid var(--line); }
.requirement-root { padding: 0 6px; background: transparent; border: 0; border-bottom: 1px solid var(--line); border-left: 0; border-radius: 0; box-shadow: none; }
.requirement-root > .requirement-node { padding: 2px 0; }
.requirement-node-head { min-height: 64px; }
.requirement-node-title strong { font-size: 12px; }
.requirement-node-title span { font-size: 10px; }
.requirement-toggle { color: #69818f; background: transparent; border-color: transparent; }
.requirement-toggle:hover { color: #315f85; background: #eaf0f4; border-color: transparent; }
.requirement-toggle.expanded { color: #315f85; }
.requirement-choice-group { background: #f7f9fa; border-color: var(--line); }
.requirement-course-details { margin-left: 22px; background: #f8fafb; border-color: var(--line); }
.requirement-course-table-wrap { border-color: var(--line); }
.requirement-course-table th { background: #f4f6f7; border-color: var(--line); }

.selection-intro { padding: 15px 0; background: transparent; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; }
.selection-catalog, .selection-runner { padding: 0; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.selection-controls { padding-bottom: 14px; border-bottom: 1px solid var(--line); }
.selection-target { background: #f7f9fa; border-color: var(--line); }
.selection-attempts { border-color: var(--line); border-radius: 7px; }
.selection-attempts > div { border-color: var(--line); }
.course-grid { gap: 12px; }
.course-card { min-height: 190px; padding: 17px 16px 14px; background: rgba(255,255,255,.85); border-color: var(--line); border-radius: 9px; box-shadow: none; }
.course-card:hover { border-color: #cbd5dc; box-shadow: 0 12px 26px -25px rgba(28, 42, 51, .55); transform: translateY(-1px); }
.course-accent { height: 3px; }
.course-card h3 { margin-top: 14px; font-size: 15px; }
.course-stats { padding: 13px 0 11px; }
.notice-list { gap: 0; border-top: 1px solid var(--line); }
.notice-list article { padding: 16px 3px; background: transparent; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; box-shadow: none; }
.notice-source { border-radius: 7px; }

.settings-layout { gap: 28px; }
.settings-section { padding: 0; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.settings-title { margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
.settings-title h2 { font-family: 'Noto Serif SC', 'Segoe UI', sans-serif; font-size: 16px; }
.settings-icon { width: 34px; height: 34px; border-radius: 8px; }
.connection-list { padding: 0; background: transparent; border: 0; border-radius: 0; }
.connection-list > div { min-height: 39px; padding: 0; border-bottom: 1px solid var(--line); }
.connection-list > div:last-child { border-bottom: 0; }
.secondary-button { min-height: 32px; padding: 0 11px; color: #4e5d68; background: #edf1f3; border-color: transparent; border-radius: 6px; font-size: 11px; }
.secondary-button:hover { color: var(--ink); background: #e3e9ec; }
.danger-button { min-height: 32px; padding: 0 11px; border-radius: 6px; font-size: 11px; }
.credential-form { gap: 10px; }
.credential-form input { padding: 0 9px; }
.sync-log-panel, .fetch-log-row { background: #f8fafb; border-color: var(--line); }
.activity-log-list { border-color: var(--line); border-radius: 7px; }
.activity-log-row { border-color: var(--line); }
.export-grid { gap: 7px; }
.export-grid button { min-height: 62px; background: #f8fafb; border-color: var(--line); border-radius: 7px; }
.export-grid button:hover { background: #f1f5f7; border-color: #cfd9df; }
.modal-backdrop { background: rgba(25, 33, 42, .36); backdrop-filter: blur(5px); }
.credential-modal { padding: 24px; border-color: rgba(255,255,255,.55); border-radius: 12px; box-shadow: var(--shadow-float); }
.command-palette-backdrop { position: fixed; inset: 0; z-index: 120; display: grid; place-items: start center; padding-top: 13vh; background: rgba(28, 35, 43, .18); backdrop-filter: blur(9px); animation: theia-soft-in .18s var(--ease-out) both; }
.command-palette { width: min(520px, calc(100vw - 32px)); overflow: hidden; background: rgba(255, 255, 255, .96); border: 1px solid rgba(255, 255, 255, .82); border-radius: 12px; box-shadow: 0 24px 80px -34px rgba(25, 35, 45, .48), 0 2px 8px rgba(25, 35, 45, .08); }
.command-palette-search { display: flex; align-items: center; gap: 9px; min-height: 52px; padding: 0 10px 0 15px; color: #6e7c86; border-bottom: 1px solid var(--line); }
.command-palette-search input { flex: 1; min-width: 0; height: 36px; color: var(--ink); background: transparent; border: 0; outline: 0; font-size: 13px; }
.command-palette-search input::placeholder { color: #a4adb4; }
.command-palette-list { display: grid; max-height: min(360px, 48vh); overflow: auto; padding: 7px; }
.command-palette-list button { display: flex; align-items: center; gap: 10px; min-height: 42px; padding: 0 10px; color: #5d6972; background: transparent; border-radius: 7px; text-align: left; }
.command-palette-list button:hover { color: var(--ink); background: #f0f4f6; }
.command-palette-list button > span { flex: 1; font-size: 12px; }
.command-palette-list button > svg:first-child { color: #52738f; }
.command-palette-list button > svg:last-child { color: #aab2b8; }
.command-palette-empty { padding: 26px 12px; color: var(--muted); font-size: 11px; text-align: center; }

@media (max-width: 1180px) {
  .topbar { padding-left: 26px; padding-right: 26px; }
  .content-area { padding-left: 26px; padding-right: 26px; }
  .login-banner, .preview-banner, .message-bar, .sync-live-banner { margin-left: 26px; margin-right: 26px; }
}

@media (max-width: 920px) {
  .sidebar { background: rgba(255,255,255,.97); box-shadow: var(--shadow-float); }
  .topbar { padding: 14px 20px; }
  .content-area { padding: 24px 20px 42px; }
  .login-banner, .preview-banner, .message-bar, .sync-live-banner { margin-left: 20px; margin-right: 20px; }
}

@media (max-width: 720px) {
  .topbar { min-height: 68px; }
  .source-group { display: none; }
  .content-area { padding: 20px 16px 36px; }
  .login-banner, .preview-banner, .message-bar, .sync-live-banner { margin-left: 16px; margin-right: 16px; }
  .metric-strip button, .grade-summary > div, .progress-summary > div { border-right: 0; border-bottom: 1px solid var(--line); }
  .metric-strip button:nth-last-child(-n + 2), .grade-summary > div:nth-last-child(-n + 2), .progress-summary > div:nth-last-child(-n + 2) { border-bottom: 0; }
  .dashboard-grid { gap: 24px; }
  .quick-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .section-heading { align-items: start; flex-direction: column; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}

@layer legacy {
* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; background: #f4f7f6; }
button, input { font: inherit; }
button { border: 0; cursor: pointer; }
button:disabled { cursor: wait; opacity: .6; }
button:focus-visible, input:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
svg { flex: 0 0 auto; }

.loading-screen { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: 10px; color: var(--muted); }
.loading-screen strong { color: var(--ink); font-size: 25px; letter-spacing: .04em; }
.loading-wordmark, .brand-wordmark strong { font-family: 'Cinzel', Georgia, serif; }
.brand-wordmark span { font-family: 'Noto Serif SC', 'Cinzel', Georgia, serif; }
.brand-mark { width: 42px; height: 42px; display: grid; place-items: center; overflow: hidden; background: #151210; border: 1px solid #b86b2a; border-radius: 8px; box-shadow: 0 8px 18px rgba(151, 79, 27, .22); }
.brand-mark img { display: block; width: 100%; height: 100%; object-fit: cover; }

.app-shell { min-height: 100vh; display: flex; }
.sidebar { width: 236px; flex: 0 0 236px; display: flex; flex-direction: column; background: #fff; border-right: 1px solid var(--line); padding: 24px 14px 16px; z-index: 20; }
.brand { display: flex; align-items: center; gap: 11px; padding: 0 10px 26px; }
.brand > div:last-of-type { display: grid; gap: 1px; }
.brand-wordmark strong { color: var(--ink); font-size: 20px; letter-spacing: .08em; }
.brand-wordmark span { color: #9b6a37; font-size: 11px; letter-spacing: .18em; }
.sidebar-close { display: none; margin-left: auto; background: transparent; color: var(--muted); }
.sidebar nav { display: grid; gap: 4px; }
.sidebar nav button { min-height: 42px; display: flex; align-items: center; gap: 12px; padding: 0 13px; color: #61706c; background: transparent; border-radius: 6px; text-align: left; transition: color .15s ease, background .15s ease; }
.sidebar nav button:hover { color: var(--ink); background: #f1f6f4; }
.sidebar nav button.active { color: var(--red-dark); background: #f9e9e9; font-weight: 650; }
.sidebar nav button em { margin-left: auto; min-width: 22px; height: 22px; display: grid; place-items: center; color: white; background: var(--red); border-radius: 12px; font-size: 11px; font-style: normal; }
.sidebar-bottom { margin-top: auto; display: grid; gap: 12px; }
.sync-summary { display: grid; gap: 6px; padding: 13px 12px; color: var(--muted); background: #f7faf9; border: 1px solid #e5eeeb; border-radius: 6px; font-size: 11px; }
.sync-summary > div { display: flex; align-items: center; gap: 7px; color: var(--ink); font-size: 12px; }
.sync-light { width: 7px; height: 7px; background: #3b9a6b; border-radius: 50%; }
.sync-light.error { background: var(--amber); }
.sidebar-bottom > button { display: flex; align-items: center; gap: 8px; padding: 0 12px; color: #61706c; background: transparent; font-size: 12px; text-align: left; }
.api-port { margin-left: auto; color: #92a09c; font-variant-numeric: tabular-nums; }

.workspace { min-width: 0; flex: 1; }
.topbar { min-height: 86px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 18px 34px; background: rgba(255,255,255,.88); border-bottom: 1px solid var(--line); }
.page-title { display: flex; align-items: center; gap: 14px; min-width: 0; }
.page-title h1 { margin: 0; color: var(--ink); font-size: 24px; letter-spacing: -.01em; }
.page-title p { margin: 5px 0 0; color: var(--muted); font-size: 13px; }
.mobile-menu { display: none; width: 36px; height: 36px; place-items: center; color: var(--ink); background: transparent; }
.top-actions { display: flex; align-items: center; gap: 16px; }
.source-group { display: flex; align-items: center; gap: 10px; }
.source-status { display: inline-flex; align-items: center; gap: 5px; color: #61706c; font-size: 12px; white-space: nowrap; }
.source-status.connected { color: var(--teal); }
.source-status.offline { color: #9a6c56; }
.icon-button { position: relative; width: 36px; height: 36px; display: inline-grid; place-items: center; color: #5e706b; background: transparent; border: 1px solid transparent; border-radius: 6px; }
.icon-button:hover { color: var(--ink); background: #eff5f3; border-color: var(--line); }
.icon-button[data-tooltip]::after { content: attr(data-tooltip); position: absolute; right: 0; top: calc(100% + 8px); z-index: 50; padding: 5px 8px; color: white; background: #22302d; border-radius: 4px; font-size: 11px; white-space: nowrap; opacity: 0; pointer-events: none; transform: translateY(-2px); transition: opacity .12s ease, transform .12s ease; }
.icon-button[data-tooltip]:hover::after { opacity: 1; transform: translateY(0); }
.sync-button { color: var(--red-dark); border-color: #f0d1d2; background: #fff7f7; }
.spinning { animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.profile-chip { display: flex; align-items: center; gap: 8px; color: #435450; font-size: 13px; white-space: nowrap; }
.profile-chip > div { width: 31px; height: 31px; display: grid; place-items: center; color: white; background: var(--teal); border-radius: 50%; font-weight: 700; }
.search-box { height: 36px; width: 200px; display: flex; align-items: center; gap: 8px; padding: 0 10px; color: #72817d; background: #f8fbfa; border: 1px solid var(--line); border-radius: 6px; }
.search-box input { width: 100%; min-width: 0; border: 0; outline: 0; color: var(--ink); background: transparent; font-size: 12px; }

.login-banner, .preview-banner, .message-bar { display: flex; align-items: center; gap: 12px; margin: 22px 34px 0; padding: 12px 14px; border-radius: 6px; }
.sync-live-banner { display: flex; align-items: flex-start; gap: 11px; margin: 16px 34px 0; padding: 12px 14px; color: #365d62; background: #edf8f7; border: 1px solid #c5e4df; border-radius: 6px; }
.sync-live-banner > svg { margin-top: 2px; color: var(--teal); }
.sync-live-banner > div { display: grid; gap: 3px; min-width: 0; }
.sync-live-banner strong { color: #245b58; font-size: 13px; }
.sync-live-banner span { color: #3f7473; font-size: 12px; }
.sync-live-banner small { color: #6d8985; font-size: 11px; }
.login-banner { color: #71423d; background: #fff5ed; border: 1px solid #f2dac5; }
.login-banner > div { display: grid; gap: 2px; flex: 1; }
.login-banner strong { color: #6d3634; font-size: 13px; }
.login-banner span { color: #8f6760; font-size: 12px; }
.login-banner button, .primary-button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 34px; padding: 0 13px; color: white; background: var(--red); border-radius: 5px; font-size: 12px; font-weight: 650; }
.login-banner button:hover, .primary-button:hover { background: var(--red-dark); }
.preview-banner { color: #4b6370; background: #edf5f8; border: 1px solid #d5e6ec; font-size: 12px; }
.message-bar { color: #775523; background: #fff8e8; border: 1px solid #efdcb1; font-size: 12px; }
.message-bar span { flex: 1; }
.message-bar button { display: grid; place-items: center; color: inherit; background: transparent; }

.content-area { max-width: 1500px; margin: 0 auto; padding: 28px 34px 44px; }
.dashboard-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(300px, .85fr); gap: 18px; }
.span-full { grid-column: 1 / -1; }
.metric-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; overflow: hidden; background: var(--line); border: 1px solid var(--line); border-radius: 7px; box-shadow: var(--shadow); }
.metric-strip button { min-height: 94px; display: grid; grid-template-columns: auto 1fr; grid-template-rows: 1fr 1fr; column-gap: 12px; align-items: center; padding: 15px 20px; color: #50645f; background: white; text-align: left; }
.metric-strip button:hover { background: #fbfdfc; }
.metric-strip svg { grid-row: 1 / -1; color: var(--red); }
.metric-strip span { font-size: 12px; }
.metric-strip strong { color: var(--ink); font-size: 23px; line-height: 1; font-variant-numeric: tabular-nums; }
.panel { min-width: 0; padding: 22px; background: var(--paper); border: 1px solid var(--line); border-radius: 7px; box-shadow: var(--shadow); }
.panel-large { min-height: 290px; }
.panel-heading { display: flex; justify-content: space-between; align-items: start; gap: 12px; margin-bottom: 18px; }
.eyebrow { display: block; color: var(--red); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
.panel h2 { margin: 4px 0 0; color: var(--ink); font-size: 18px; }
.text-command, .link-button { display: inline-flex; align-items: center; gap: 5px; color: var(--teal); background: transparent; font-size: 12px; font-weight: 650; }
.text-command:hover, .link-button:hover { color: var(--red-dark); }
.timeline-list, .task-list { display: grid; gap: 8px; }
.timeline-row, .task-row { min-height: 58px; display: grid; grid-template-columns: 60px minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 9px 0; border-bottom: 1px solid #edf2f0; }
.timeline-row:last-child, .task-row:last-child { border-bottom: 0; }
.timeline-row > div:nth-child(2), .task-row > div:nth-child(2) { min-width: 0; display: grid; gap: 4px; }
.timeline-row strong, .task-row strong { overflow: hidden; color: var(--ink); font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
.timeline-row span, .task-row span { overflow: hidden; color: var(--muted); font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
.timeline-row small { color: #899790; font-size: 11px; }
.period-pill { min-height: 29px; display: grid; place-items: center; color: var(--blue); background: #edf3f8; border-radius: 4px; font-size: 11px; font-weight: 650; }
.task-row { grid-template-columns: 28px minmax(0, 1fr) auto auto; }
.task-state { width: 26px; height: 26px; display: grid; place-items: center; color: var(--teal); background: var(--teal-soft); border-radius: 50%; }
.task-state.urgent { color: var(--red); background: #fae7e7; }
.task-due { display: grid; justify-items: end; gap: 2px; }
.task-due strong { color: var(--red-dark); font-size: 11px; }
.task-due span { color: #8c9995; font-size: 10px; }
.task-title small { overflow: hidden; color: #7a8984; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.task-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 7px; max-width: 420px; }
.task-command { min-height: 28px; display: inline-flex; align-items: center; gap: 5px; padding: 0 9px; color: #42635a; background: #f5f8f6; border: 1px solid #dce8e2; border-radius: 4px; font-size: 11px; font-weight: 650; white-space: nowrap; }
.task-command:hover:not(:disabled) { color: var(--teal); border-color: #b9d3c7; background: #eef7f2; }
.task-command.emphasis { color: #fff; background: var(--teal); border-color: var(--teal); }
.task-command.emphasis:hover:not(:disabled) { color: #fff; background: #176f62; border-color: #176f62; }
.task-command:disabled { cursor: wait; opacity: .55; }
.exam-focus { min-height: 166px; display: flex; align-items: center; gap: 18px; }
.date-block { width: 67px; height: 76px; display: grid; place-content: center; justify-items: center; color: var(--red-dark); background: #fae7e7; border: 1px solid #f1cfd0; border-radius: 6px; }
.date-block strong { font-size: 24px; line-height: 1; }
.date-block span { margin-top: 5px; font-size: 12px; }
.exam-focus h3 { margin: 0 0 8px; color: var(--ink); font-size: 17px; }
.exam-focus p { display: flex; align-items: center; gap: 6px; margin: 5px 0; color: var(--muted); font-size: 12px; }
.seat-badge, .score-badge { display: inline-flex; align-items: center; min-height: 22px; padding: 0 7px; color: var(--red-dark); background: #fff1ef; border-radius: 4px; font-size: 10px; font-weight: 700; }
.notice-compact { display: grid; gap: 1px; }
.notice-compact button { display: grid; grid-template-columns: 9px minmax(0, 1fr); gap: 10px; padding: 10px 0; color: var(--ink); background: transparent; text-align: left; border-bottom: 1px solid #edf2f0; }
.notice-compact button:last-child { border-bottom: 0; }
.notice-compact button > span:last-child { min-width: 0; display: grid; gap: 4px; }
.notice-compact strong { overflow: hidden; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.notice-compact small { color: var(--muted); font-size: 10px; }
.source-pin { width: 8px; height: 8px; margin-top: 4px; border-radius: 50%; background: var(--blue); }
.source-pin.theol { background: var(--teal); }

.empty-state { min-height: 150px; display: grid; place-content: center; justify-items: center; gap: 7px; color: #9aa8a4; text-align: center; }
.empty-state strong { color: #64736f; font-size: 13px; }
.empty-state span { max-width: 300px; font-size: 11px; }

.schedule-scroll { max-width: 100%; overflow-x: auto; padding-bottom: 8px; }
.schedule-board { display: grid; grid-template-columns: repeat(7, minmax(140px, 1fr)); gap: 10px; min-width: 980px; }
.schedule-board::before { content: ''; position: fixed; pointer-events: none; }
.day-column { min-height: 560px; background: #fff; border: 1px solid var(--line); border-radius: 7px; box-shadow: var(--shadow); }
.day-column > header { min-height: 60px; display: flex; flex-direction: column; justify-content: center; gap: 4px; padding: 0 14px; border-bottom: 1px solid var(--line); }
.day-column > header strong { color: var(--ink); font-size: 14px; }
.day-column > header span { color: var(--muted); font-size: 10px; }
.day-courses { display: grid; gap: 8px; padding: 10px; }
.course-slot { min-height: 132px; padding: 12px; background: #f8fbfa; border-left: 3px solid var(--teal); border-radius: 5px; }
.course-slot:nth-child(3n) { border-left-color: var(--red); }
.course-slot:nth-child(3n + 1) { border-left-color: var(--blue); }
.course-slot > span { color: var(--blue); font-size: 10px; font-weight: 700; }
.course-slot h3 { margin: 7px 0 10px; color: var(--ink); font-size: 13px; }
.course-slot p { display: flex; align-items: center; gap: 5px; margin: 5px 0; color: var(--muted); font-size: 10px; }
.course-slot small { display: block; margin-top: 9px; color: #92a09c; font-size: 10px; }
.day-empty { display: grid; min-height: 120px; place-items: center; color: #a7b2ae; font-size: 11px; }

.campus-map-panel { min-width: 0; overflow: hidden; background: #e9f4f0; border: 1px solid var(--line); border-radius: 7px; box-shadow: var(--shadow); }
.map-stage { position: relative; height: clamp(560px, calc(100svh - 160px), 900px); display: grid; place-items: center; overflow: hidden; background: #e9f4f0; cursor: grab; outline: none; touch-action: none; user-select: none; }
.map-stage:focus-visible { outline: 2px solid var(--red); outline-offset: -3px; }
.map-stage.is-dragging { cursor: grabbing; }
.map-sheet { position: relative; width: auto; height: clamp(560px, calc(100svh - 160px), 900px); aspect-ratio: 6874 / 10063; flex: 0 0 auto; transform-origin: center; transition: transform .14s ease-out; will-change: transform; filter: drop-shadow(0 8px 14px rgba(24, 57, 48, .12)); }
.map-stage.is-dragging .map-sheet { transition: none; }
.map-sheet img { display: block; width: 100%; max-width: none; height: 100%; pointer-events: none; }
.map-satellite-overlay { position: absolute; inset: 0; }
.map-control-stack { position: absolute; top: 14px; right: 14px; z-index: 5; display: grid; gap: 8px; }
.map-layer-controls, .map-zoom-controls { display: grid; gap: 4px; padding: 4px; background: rgba(255, 255, 255, .9); border: 1px solid rgba(215, 228, 223, .94); border-radius: 7px; box-shadow: 0 5px 14px rgba(32, 55, 48, .12); }
.map-tool-button { width: 32px; height: 32px; color: #50645f; background: transparent; border-color: transparent; }
.map-tool-button:hover { color: var(--red-dark); background: #eef6f3; border-color: #b7d9d2; }
.map-tool-button.active { color: var(--red-dark); background: #fae7e7; border-color: #efcfd1; }

.list-stack { display: grid; gap: 10px; }
.exam-row { display: grid; grid-template-columns: 200px minmax(160px, 1fr) minmax(200px, .8fr) auto; align-items: center; gap: 20px; min-height: 94px; padding: 18px 20px; background: #fff; border: 1px solid var(--line); border-radius: 7px; box-shadow: var(--shadow); }
.exam-date { display: grid; grid-template-columns: auto 1fr; grid-template-rows: 1fr 1fr; column-gap: 9px; align-items: center; color: var(--red-dark); }
.exam-date svg { grid-row: 1 / -1; }
.exam-date strong { font-size: 13px; }
.exam-date span { color: var(--muted); font-size: 11px; }
.exam-main h3 { margin: 0 0 6px; color: var(--ink); font-size: 15px; }
.exam-main p, .exam-location span { margin: 0; color: var(--muted); font-size: 11px; }
.exam-location { display: grid; gap: 6px; }
.exam-location strong { color: var(--ink); font-size: 12px; }
.data-page { display: grid; gap: 18px; }
.grade-summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 7px; overflow: hidden; box-shadow: var(--shadow); }
.gpa-trend { display: grid; gap: 12px; padding: 20px; }
.gpa-chart-controls { display: flex; flex-wrap: wrap; justify-content: end; gap: 7px; }
.gpa-chart-wrap { width: 100%; overflow-x: auto; }
.gpa-chart { display: block; width: 100%; min-width: 520px; height: auto; }
.gpa-grid-line { stroke: #e6efeb; stroke-width: 1; }
.gpa-axis-label, .gpa-x-label { fill: #84938e; font-size: 10px; }
.gpa-line { fill: none; stroke: var(--teal); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
.gpa-point { fill: #fff; stroke: #2b8b7a; stroke-width: 2.5; cursor: pointer; transition: r .15s ease, fill .15s ease; }
.gpa-point:hover, .gpa-point:focus { r: 7; fill: #e4f4ef; }
.remark-text { display: block; margin-top: 4px; font-size: 10px; }
.remark-text.info { color: #2d6d91; }
.remark-text.attention { color: #94651f; }
.remark-text.danger { color: #a23e45; }
.remark-text.neutral { color: #667874; }
.remark-badge { display: inline-flex; align-items: center; justify-content: center; padding: 4px 7px; border-radius: 4px; font-size: 10px; font-weight: 700; white-space: nowrap; }
.remark-badge.info { color: #2d6d91; background: #eaf3f8; border: 1px solid #c7dfe9; }
.remark-badge.attention { color: #94651f; background: #fff2dc; border: 1px solid #f0d7a5; }
.remark-badge.danger { color: #a23e45; background: #fbe9e9; border: 1px solid #efcfd1; }
.remark-badge.neutral { color: #667874; background: #edf2f0; border: 1px solid #d9e5e1; }
.grade-summary > div { display: grid; gap: 8px; padding: 17px 20px; background: #fff; }
.grade-summary span { color: var(--muted); font-size: 11px; }
.grade-summary strong { color: var(--ink); font-size: 24px; font-variant-numeric: tabular-nums; }
.data-table-wrap { overflow: auto; background: #fff; border: 1px solid var(--line); border-radius: 7px; box-shadow: var(--shadow); }
.data-table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 12px; }
.data-table th { padding: 13px 16px; color: #72817d; background: #f6faf8; font-size: 10px; font-weight: 700; text-align: left; letter-spacing: .05em; }
.data-table td { padding: 15px 16px; color: var(--muted); border-top: 1px solid #edf2f0; white-space: nowrap; }
.data-table td strong { color: var(--ink); font-size: 12px; }
.data-table .link-button { width: 27px; height: 27px; padding: 0; justify-content: center; }

.progress-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)) auto; gap: 1px; align-items: stretch; overflow: hidden; background: var(--line); border: 1px solid var(--line); border-radius: 7px; box-shadow: var(--shadow); }
.progress-summary > div { display: grid; align-content: center; gap: 7px; min-height: 92px; padding: 16px 20px; background: #fff; }
.progress-summary span { color: var(--muted); font-size: 11px; }
.progress-summary strong { color: var(--ink); font-size: 23px; font-variant-numeric: tabular-nums; }
.progress-summary .link-button { justify-self: center; align-self: center; padding: 0 17px; white-space: nowrap; }
.progress-categories, .selected-course-section { display: grid; gap: 12px; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 14px; }
.section-heading h2 { margin: 4px 0 0; color: var(--ink); font-size: 18px; }
.section-heading > span { color: var(--muted); font-size: 12px; }
.requirement-map { display: grid; gap: 10px; }
.requirement-root { padding: 0 18px; background: #fff; border: 1px solid var(--line); border-left: 3px solid var(--teal); border-radius: 7px; box-shadow: var(--shadow); }
.requirement-node { position: relative; min-width: 0; }
.requirement-root > .requirement-node { padding: 5px 0; }
.requirement-node-head { display: grid; grid-template-columns: minmax(175px, 1fr) auto minmax(95px, .42fr); align-items: center; gap: 16px; min-height: 68px; }
.requirement-node-title { min-width: 0; display: flex; align-items: center; gap: 10px; }
.requirement-node-title > div { min-width: 0; display: grid; gap: 4px; }
.requirement-node-title strong { overflow: hidden; color: var(--ink); font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
.requirement-node-title span { overflow: hidden; color: var(--muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.requirement-toggle, .requirement-toggle-placeholder { width: 18px; height: 18px; flex: 0 0 18px; }
.requirement-toggle { display: inline-grid; place-items: center; color: #648079; background: #f1f6f4; border: 1px solid #d9e7e2; border-radius: 4px; transition: color .15s ease, background .15s ease, border-color .15s ease, transform .16s ease; }
.requirement-toggle:hover { color: var(--red-dark); background: #fff7f7; border-color: #efcfd1; }
.requirement-toggle.expanded { color: var(--teal); transform: rotate(90deg); }
.requirement-toggle-placeholder { display: block; }
.requirement-state { width: 9px; height: 9px; flex: 0 0 9px; border: 2px solid #a4b4ae; border-radius: 50%; }
.requirement-state.complete { border-color: var(--teal); background: var(--teal); box-shadow: 0 0 0 3px #e5f4ee; }
.requirement-state.pending { border-color: #c48b2c; background: #fff6df; }
.requirement-state.neutral { border-color: #9eaaa6; background: #fff; }
.requirement-credit { display: grid; justify-items: end; gap: 3px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
.requirement-credit strong { color: var(--ink); font-size: 14px; }
.requirement-credit strong small { color: #788984; font-size: 11px; font-weight: 600; }
.requirement-credit span { color: var(--muted); font-size: 10px; }
.requirement-meter { height: 6px; overflow: hidden; background: #e8efec; border-radius: 3px; }
.requirement-meter i { display: block; height: 100%; background: #739e92; border-radius: inherit; }
.requirement-meter i.complete { background: var(--teal); }
.requirement-meter i.pending { background: #c58d30; }
.requirement-meter i.neutral { background: #8a9a94; }
.requirement-children { position: relative; display: grid; gap: 0; margin: 0 0 4px 17px; padding: 0 0 0 22px; border-left: 1px solid #dbe6e1; }
.requirement-children > .requirement-node::before, .requirement-choice-group::before { position: absolute; top: 33px; left: -23px; width: 15px; border-top: 1px solid #dbe6e1; content: ''; }
.requirement-children > .requirement-node > .requirement-node-head { border-bottom: 1px solid #edf2f0; }
.requirement-children > .requirement-node:last-child > .requirement-node-head { border-bottom: 0; }
.requirement-node.depth-2 .requirement-node-head, .requirement-node.depth-3 .requirement-node-head { min-height: 60px; }
.requirement-node.depth-2 .requirement-node-title strong, .requirement-node.depth-3 .requirement-node-title strong { font-size: 12px; }
.requirement-choice-group { position: relative; margin: 8px 0 10px; padding: 11px 12px 12px; background: #f6faf8; border: 1px solid #dce9e4; border-radius: 6px; }
.requirement-choice-heading { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
.requirement-choice-heading span { color: #2e7969; font-size: 11px; font-weight: 750; }
.requirement-choice-heading small { color: #60746e; font-size: 10px; }
.requirement-choice-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0 18px; }
.requirement-choice-grid > .requirement-node > .requirement-node-head { border-top: 1px solid #e2ece8; }
.requirement-choice-grid > .requirement-node:nth-child(-n + 2) > .requirement-node-head { border-top: 0; }
.requirement-choice-grid .requirement-children { margin-left: 12px; padding-left: 16px; }
.requirement-course-details { margin: 0 0 14px 27px; padding: 12px 13px 13px; background: #f8fbfa; border: 1px solid #dce8e3; border-radius: 6px; }
.requirement-course-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
.requirement-course-heading span { color: #365d54; font-size: 12px; font-weight: 750; }
.requirement-course-heading small { color: var(--muted); font-size: 10px; }
.requirement-course-table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid #e1ebe7; border-radius: 5px; background: #fff; }
.requirement-course-table { width: 100%; min-width: 1180px; border-collapse: collapse; color: #51645f; font-size: 11px; white-space: nowrap; }
.requirement-course-table th { padding: 9px 10px; color: #647671; background: #f1f6f4; border-bottom: 1px solid #dfeae5; font-size: 10px; font-weight: 700; text-align: left; }
.requirement-course-table td { padding: 9px 10px; border-bottom: 1px solid #edf2f0; font-variant-numeric: tabular-nums; }
.requirement-course-table tbody tr:last-child td { border-bottom: 0; }
.requirement-course-table tbody tr:hover { background: #fbfdfc; }
.requirement-course-table td:nth-child(5) { min-width: 150px; color: var(--ink); }
.requirement-course-table td strong { color: inherit; font-weight: 650; }
.selected-course-table td:first-child { display: grid; gap: 4px; }
.selected-course-table td:first-child small { color: #899790; font-size: 10px; }

.selection-page { display: grid; gap: 18px; }
.selection-intro { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 18px; background: #edf6f2; border: 1px solid #cde2d9; border-radius: 7px; }
.selection-intro > div { min-width: 0; display: flex; align-items: center; gap: 11px; color: var(--teal); }
.selection-intro > div > div { min-width: 0; display: grid; gap: 4px; }
.selection-intro strong { color: var(--ink); font-size: 13px; }
.selection-intro span { color: #587168; font-size: 11px; }
.selection-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(310px, .42fr); gap: 18px; align-items: start; }
.selection-catalog, .selection-runner { min-width: 0; padding: 20px; background: #fff; border: 1px solid var(--line); border-radius: 7px; box-shadow: var(--shadow); }
.selection-controls { display: flex; align-items: end; gap: 10px; margin-bottom: 16px; }
.selection-controls label, .selection-form > label, .selection-number-grid label { min-width: 0; display: grid; gap: 6px; color: #53645f; font-size: 11px; font-weight: 650; }
.selection-controls label { flex: 1; }
.selection-controls select, .selection-form input { width: 100%; height: 36px; padding: 0 10px; color: var(--ink); background: #f8fbfa; border: 1px solid var(--line); border-radius: 5px; }
.selection-table { min-width: 780px; }
.selection-table tr { cursor: pointer; }
.selection-table tbody tr:hover, .selection-table tbody tr.selected { background: #f1f8f5; }
.selection-table td:first-child { width: 32px; padding-right: 0; }
.selection-table td:nth-child(2), .selection-table td:nth-child(4) { display: grid; gap: 4px; }
.selection-table td small { overflow: hidden; color: #899790; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.seat-open, .seat-full { display: inline-flex; min-width: 46px; justify-content: center; padding: 3px 5px; border-radius: 4px; font-size: 10px; font-weight: 700; }
.seat-open { color: #18725f; background: #e6f5ee; }
.seat-full { color: #a23e45; background: #fbe9e9; }
.selection-runner { display: grid; gap: 18px; }
.selection-status { padding: 4px 7px; color: #5b6c67; background: #edf2f0; border-radius: 4px; font-size: 10px; font-weight: 700; text-transform: uppercase; }
.selection-status.running { color: #8a5c11; background: #fff0d7; }
.selection-status.selected { color: #18725f; background: #e6f5ee; }
.selection-status.exhausted, .selection-status.stopped { color: #a23e45; background: #fbe9e9; }
.selection-form, .selection-active { display: grid; gap: 14px; }
.selection-target { display: grid; gap: 5px; padding: 13px; background: #f7faf9; border: 1px solid #e5eeeb; border-radius: 6px; }
.selection-target span, .selection-active span { color: var(--muted); font-size: 10px; }
.selection-target strong, .selection-active strong { color: var(--ink); font-size: 13px; }
.selection-target small { color: #687973; font-size: 10px; }
.selection-number-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.selection-start { width: 100%; }
.selection-active > div:not(.selection-attempts) { display: grid; gap: 5px; padding-bottom: 11px; border-bottom: 1px solid #edf2f0; }
.selection-attempts { display: grid; gap: 1px; max-height: 270px; overflow: auto; border: 1px solid #e5eeeb; border-radius: 6px; }
.selection-attempts > div { display: grid; grid-template-columns: 28px 42px minmax(0, 1fr); align-items: center; gap: 8px; min-height: 39px; padding: 7px 9px; border-bottom: 1px solid #edf2f0; }
.selection-attempts > div:last-child { border-bottom: 0; }
.selection-attempts span { color: #86948f; font-variant-numeric: tabular-nums; }
.selection-attempts strong { font-size: 10px; }
.selection-attempts small { overflow: hidden; color: var(--muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }

.course-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(245px, 1fr)); gap: 15px; }
.course-card { position: relative; min-height: 215px; display: flex; flex-direction: column; padding: 20px 18px 16px; background: #fff; border: 1px solid var(--line); border-radius: 7px; box-shadow: var(--shadow); overflow: hidden; }
.course-accent { position: absolute; inset: 0 0 auto; height: 4px; background: var(--teal); }
.course-accent.theol { background: var(--teal); }
.course-accent.jwglxt { background: var(--blue); }
.course-card-head { display: flex; justify-content: space-between; gap: 8px; color: #85938f; font-size: 10px; }
.source-tag { color: var(--teal); }
.course-card h3 { margin: 16px 0 8px; color: var(--ink); font-size: 16px; }
.course-card > p { display: flex; align-items: center; gap: 6px; margin: 0; color: var(--muted); font-size: 11px; }
.course-stats { display: flex; gap: 12px; margin-top: auto; padding: 17px 0 14px; color: #81908b; font-size: 10px; }
.course-stats span { display: inline-flex; align-items: center; gap: 5px; }
.course-card .link-button { align-self: flex-start; }

.segmented { display: inline-flex; gap: 2px; padding: 3px; background: #eaf1ee; border-radius: 6px; }
.segmented button { min-height: 30px; padding: 0 13px; color: #70807b; background: transparent; border-radius: 4px; font-size: 11px; }
.segmented button.active { color: var(--ink); background: #fff; box-shadow: 0 2px 6px rgba(36, 59, 53, .08); font-weight: 700; }
.task-list.wide { padding: 8px 20px; }
.notice-list { display: grid; gap: 10px; }
.notice-list article { display: grid; grid-template-columns: 38px minmax(0, 1fr) auto; align-items: start; gap: 14px; padding: 18px 20px; background: #fff; border: 1px solid var(--line); border-radius: 7px; box-shadow: var(--shadow); }
.notice-source { width: 36px; height: 36px; display: grid; place-items: center; color: var(--blue); background: #eaf1f7; border-radius: 6px; }
.notice-source.theol { color: var(--teal); background: var(--teal-soft); }
.notice-meta { display: flex; gap: 12px; color: var(--muted); font-size: 10px; }
.notice-meta span { color: var(--red-dark); font-weight: 700; }
.notice-list h3 { margin: 8px 0 6px; color: var(--ink); font-size: 14px; }
.notice-list p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.7; }

.settings-layout { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.settings-section { padding: 22px; background: #fff; border: 1px solid var(--line); border-radius: 7px; box-shadow: var(--shadow); }
.settings-title { display: flex; align-items: start; gap: 12px; margin-bottom: 20px; }
.settings-title h2 { margin: 0; color: var(--ink); font-size: 16px; }
.settings-title p { margin: 5px 0 0; color: var(--muted); font-size: 11px; }
.settings-icon { width: 38px; height: 38px; display: grid; place-items: center; color: var(--red-dark); background: #fae7e7; border-radius: 6px; }
.settings-icon.teal { color: var(--teal); background: var(--teal-soft); }
.settings-icon.amber { color: var(--amber); background: #fff2df; }
.settings-icon.red { color: var(--red-dark); background: #fae7e7; }
.connection-list { display: grid; gap: 10px; padding: 14px; background: #f8fbfa; border: 1px solid #e5eeeb; border-radius: 6px; }
.connection-list > div { display: flex; align-items: center; gap: 10px; font-size: 11px; }
.connection-list > div > span:last-child { color: var(--muted); }
.button-row { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 15px; }
.secondary-button { min-height: 34px; display: inline-flex; align-items: center; gap: 7px; padding: 0 13px; color: #5b6c67; background: #f2f6f4; border: 1px solid var(--line); border-radius: 5px; font-size: 12px; }
.secondary-button:hover { color: var(--ink); background: #eaf1ee; }
.danger-button { min-height: 34px; display: inline-flex; align-items: center; gap: 7px; padding: 0 13px; color: #97343b; background: #fff6f6; border: 1px solid #efcfd1; border-radius: 5px; font-size: 12px; }
.danger-button:hover { background: #fbe8e9; }
.credential-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px; margin-top: 15px; }
.credential-form > label { min-width: 0; display: grid; gap: 6px; color: #53645f; font-size: 11px; font-weight: 650; }
.credential-form input { width: 100%; height: 36px; padding: 0 10px; color: var(--ink); background: #f8fbfa; border: 1px solid var(--line); border-radius: 5px; }
.credential-form input::placeholder { color: #9ba8a4; }
.model-service-section { grid-column: 1 / -1; }
.model-service-form { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
.model-service-wide { grid-column: 1 / -1; }
.model-service-form select { width: 100%; height: 36px; padding: 0 10px; color: var(--ink); background: #f8fbfa; border: 1px solid var(--line); border-radius: 5px; }
.model-discovery-status { grid-column: 1 / -1; min-height: 17px; margin: 0; color: #55706a; font-size: 11px; line-height: 1.5; }
.model-discovery-status.error { color: #a33d31; }
.credential-security, .credential-error { grid-column: 1 / -1; display: flex; align-items: center; gap: 7px; margin: 0; font-size: 10px; line-height: 1.5; }
.credential-security { color: #55706a; }
.credential-security svg { color: var(--teal); }
.credential-error { color: #97343b; }
.academic-source-section { grid-column: 1 / -1; }
.academic-source-mode { margin-top: 14px; }
.academic-source-mode button { display: inline-flex; align-items: center; gap: 6px; }
.credential-warning { display: flex; align-items: flex-start; gap: 8px; margin-top: 14px; padding: 10px 12px; color: #805c20; background: #fff8e8; border: 1px solid #f0dfb2; border-radius: 5px; font-size: 11px; line-height: 1.5; }
.credential-warning svg { flex: 0 0 auto; margin-top: 1px; }
.credential-form > .primary-button { grid-column: 1 / -1; justify-self: start; }
.sync-log-panel { display: grid; gap: 10px; margin-top: 15px; padding: 12px; background: #f7faf9; border: 1px solid #e1ebe7; border-radius: 6px; }
.sync-log-header { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
.sync-log-header strong { color: var(--ink); font-size: 12px; }
.sync-log-header span { color: var(--muted); font-size: 10px; }
.sync-log-ok { color: #397264; font-size: 11px; line-height: 1.5; }
.sync-data-summary { display: flex; flex-wrap: wrap; gap: 6px 12px; padding-top: 9px; border-top: 1px solid #e4ede9; color: #71817c; font-size: 10px; }
.sync-data-summary strong { color: var(--ink); font-variant-numeric: tabular-nums; }
.fetch-log-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(112px, 1fr)); gap: 6px; }
.fetch-log-row { display: grid; gap: 3px; padding: 7px; border: 1px solid #e0eae6; border-radius: 4px; background: #fff; }
.fetch-log-row span, .fetch-log-row small { color: var(--muted); font-size: 10px; }
.fetch-log-row strong { color: var(--ink); font-size: 11px; }
.fetch-log-row.err strong { color: #a23e45; }
.fetch-log-row.empty strong { color: #8b6a2f; }
.sync-errors { display: grid; gap: 5px; }
.sync-error-row { display: flex; gap: 7px; align-items: start; color: #9b3d43; }
.sync-error-row small { min-width: 0; font-size: 10px; line-height: 1.45; }
.activity-log-section { grid-column: 1 / -1; }
.activity-log-section .settings-title { align-items: start; }
.activity-log-section .icon-button { margin-left: auto; }
.activity-log-list { max-height: 270px; overflow: auto; border: 1px solid #e2ebe7; border-radius: 6px; }
.activity-log-row { display: grid; grid-template-columns: 72px minmax(145px, .45fr) minmax(0, 1fr); align-items: baseline; gap: 10px; min-height: 37px; padding: 8px 10px; border-bottom: 1px solid #edf2f0; }
.activity-log-row:last-child { border-bottom: 0; }
.activity-log-row time { color: #82918c; font-size: 10px; font-variant-numeric: tabular-nums; }
.activity-log-row strong { color: var(--ink); font-size: 11px; }
.activity-log-row span { overflow: hidden; color: var(--muted); font-size: 10px; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.modal-backdrop { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 20px; background: rgba(24, 35, 32, .48); }
.credential-modal { width: min(480px, 100%); padding: 22px; background: #fff; border: 1px solid var(--line); border-radius: 7px; box-shadow: 0 24px 70px rgba(21, 34, 30, .22); }
.credential-modal > header { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; gap: 12px; }
.credential-modal h2 { margin: 1px 0 0; color: var(--ink); font-size: 18px; }
.credential-modal header p { margin: 5px 0 0; color: var(--muted); font-size: 11px; }
.credential-modal .credential-form { margin-top: 22px; }
.modal-later { display: block; margin: 13px auto 0; padding: 5px 9px; color: var(--muted); background: transparent; font-size: 11px; }
.modal-later:hover { color: var(--ink); }
.setting-row, .numeric-setting { min-height: 54px; display: flex; align-items: center; justify-content: space-between; gap: 15px; border-top: 1px solid #edf2f0; }
.setting-row > span, .numeric-setting > span { display: grid; gap: 4px; }
.setting-row strong, .numeric-setting strong { color: var(--ink); font-size: 12px; }
.setting-row small, .numeric-setting small { color: var(--muted); font-size: 10px; }
.setting-row input { position: absolute; opacity: 0; pointer-events: none; }
.setting-row i { position: relative; width: 39px; height: 22px; flex: 0 0 39px; background: #d9e3df; border-radius: 12px; transition: background .15s ease; }
.setting-row i::after { content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; background: white; border-radius: 50%; box-shadow: 0 1px 3px rgba(0,0,0,.14); transition: transform .15s ease; }
.setting-row input:checked + i { background: var(--teal); }
.setting-row input:checked + i::after { transform: translateX(17px); }
.numeric-setting input { width: 70px; height: 30px; padding: 0 8px; color: var(--ink); background: #f8fbfa; border: 1px solid var(--line); border-radius: 5px; text-align: right; }
.numeric-setting em { margin-left: -9px; color: var(--muted); font-size: 11px; font-style: normal; }
.api-endpoint { display: flex; align-items: center; gap: 8px; padding: 10px 12px; background: #f6faf8; border: 1px solid #e5eeeb; border-radius: 6px; }
.api-endpoint code { min-width: 0; flex: 1; overflow: hidden; color: var(--teal); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.endpoint-list { display: grid; grid-template-columns: max-content 1fr; gap: 11px 14px; margin-top: 17px; align-items: center; }
.endpoint-list code { color: #4a5e59; font-size: 11px; }
.endpoint-list span { color: var(--muted); font-size: 10px; }
.export-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; }
.export-grid button { min-height: 68px; display: flex; align-items: start; gap: 10px; padding: 12px; color: var(--teal); background: #f8fbfa; border: 1px solid #e5eeeb; border-radius: 6px; text-align: left; }
.export-grid button:hover { border-color: #b4d4ce; background: #f1f8f5; }
.export-grid button > span { display: grid; gap: 4px; }
.export-grid strong { color: var(--ink); font-size: 11px; }
.export-grid small { color: var(--muted); font-size: 10px; }

.sidebar-scrim { display: none; }

@media (max-width: 1180px) {
  .topbar { padding-left: 24px; padding-right: 24px; }
  .content-area { padding-left: 24px; padding-right: 24px; }
  .source-group { display: none; }
  .exam-row { grid-template-columns: 180px minmax(140px, 1fr) minmax(170px, .8fr) auto; gap: 14px; }
}

@media (max-width: 920px) {
  .sidebar { position: fixed; inset: 0 auto 0 0; transform: translateX(-100%); transition: transform .2s ease; box-shadow: 12px 0 30px rgba(22, 39, 34, .12); }
  .sidebar.open { transform: translateX(0); }
  .sidebar-close, .mobile-menu { display: grid; }
  .sidebar-scrim { display: block; position: fixed; inset: 0; z-index: 15; background: rgba(27, 41, 37, .28); }
  .topbar { padding: 16px 20px; }
  .content-area { padding: 22px 20px 36px; }
  .dashboard-grid { grid-template-columns: 1fr; }
  .span-full { grid-column: auto; }
  .settings-layout { grid-template-columns: 1fr; }
  .exam-row { grid-template-columns: 1fr 1fr auto; }
  .exam-date { grid-column: 1 / -1; }
  .progress-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .progress-summary .link-button { min-height: 56px; }
  .requirement-node-head { grid-template-columns: minmax(150px, 1fr) auto minmax(80px, .34fr); gap: 12px; }
  .selection-layout { grid-template-columns: 1fr; }
  .map-stage, .map-sheet { height: clamp(500px, calc(100svh - 130px), 720px); }
}

@media (max-width: 720px) {
  .requirement-root { padding: 0 13px; }
  .requirement-node-head { grid-template-columns: minmax(0, 1fr) auto; gap: 8px 12px; min-height: 64px; }
  .requirement-meter { grid-column: 1 / -1; margin: -5px 0 10px 19px; }
  .requirement-children { margin-left: 11px; padding-left: 16px; }
  .requirement-course-details { margin-left: 0; padding: 10px; }
  .requirement-course-heading { align-items: start; flex-direction: column; gap: 2px; }
  .requirement-children > .requirement-node::before, .requirement-choice-group::before { left: -17px; width: 10px; }
  .requirement-choice-grid { grid-template-columns: 1fr; }
  .requirement-choice-grid > .requirement-node:nth-child(2) > .requirement-node-head { border-top: 1px solid #e2ece8; }
  .activity-log-row { grid-template-columns: 62px minmax(0, 1fr); gap: 4px 9px; }
  .activity-log-row span { grid-column: 2; }
}

@media (max-width: 600px) {
  .topbar { min-height: 74px; padding: 13px 15px; }
  .page-title h1 { font-size: 20px; }
  .page-title p { display: none; }
  .top-actions { gap: 6px; }
  .profile-chip span { display: none; }
  .profile-chip > div { width: 30px; height: 30px; }
  .search-box { width: 145px; }
  .login-banner, .preview-banner, .message-bar, .sync-live-banner { margin: 15px 15px 0; }
  .login-banner span { display: none; }
  .content-area { padding: 17px 15px 28px; }
  .metric-strip { grid-template-columns: repeat(2, 1fr); }
  .metric-strip button { min-height: 78px; padding: 12px 14px; }
  .metric-strip strong { font-size: 20px; }
  .panel { padding: 17px; }
  .timeline-row { grid-template-columns: 53px minmax(0, 1fr); }
  .timeline-row small { grid-column: 2; }
  .task-row { grid-template-columns: 28px minmax(0, 1fr) auto; }
  .task-actions { grid-column: 2 / -1; justify-content: flex-start; max-width: none; padding-top: 2px; }
  .task-row .link-button { display: none; }
  .exam-focus { align-items: start; }
  .exam-row { grid-template-columns: 1fr auto; gap: 11px 15px; padding: 15px; }
  .exam-date { grid-column: 1 / -1; }
  .exam-location { grid-column: 1 / -1; }
  .exam-row .link-button { grid-column: 2; grid-row: 3; }
  .grade-summary { grid-template-columns: repeat(2, 1fr); }
  .gpa-chart-controls { justify-content: start; }
  .grade-summary > div { padding: 13px 15px; }
  .grade-summary strong { font-size: 20px; }
  .progress-category-row { grid-template-columns: minmax(0, 1fr) auto; gap: 9px 14px; padding: 13px 15px; }
  .progress-category-row > div:first-child { grid-column: 1 / -1; }
  .credit-bar { min-width: 0; }
  .progress-category-row > small { text-align: right; }
  .selection-intro { align-items: start; flex-direction: column; }
  .selection-controls { align-items: stretch; flex-direction: column; }
  .selection-controls .primary-button { justify-content: center; }
  .notice-list article { grid-template-columns: 34px minmax(0, 1fr); padding: 15px; }
  .notice-list article > .link-button { grid-column: 2; justify-self: start; }
  .map-stage, .map-sheet { height: clamp(430px, 60svh, 620px); }
  .map-control-stack { top: 10px; right: 10px; }
  .export-grid { grid-template-columns: 1fr; }
  .credential-form { grid-template-columns: 1fr; }
  .model-service-section { grid-column: auto; }
  .credential-security, .credential-error, .credential-form > .primary-button { grid-column: 1; }
}
}
